# 服务端口（云服务器防火墙已放行 8888）
PORT=8888

# 监听地址：本地开发用 127.0.0.1，云服务器对外访问必须是 0.0.0.0
HOST=0.0.0.0

# 32 字节随机密钥（64 位 hex），用于加密落库的大模型 API Key
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 一经生成请长期固定，更换会导致已保存的 API Key 无法解密
APP_ENCRYPTION_KEY=

# 会话 Cookie 是否只允许 HTTPS。仅当已配置 Nginx + HTTPS 时才设为 true；
# 直接以 http://IP:8888 访问时必须为 false，否则浏览器不保存 Cookie，登录后立刻掉线。
COOKIE_SECURE=false

# 系统内置默认模型（不落库、密钥永不回显）。配置后，用户不添加任何模型即可直接生成规划。
# DEFAULT_LLM_API_KEY 留空则不启用内置默认模型，用户需自行在「模型设置」新增配置。
DEFAULT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=qwen-plus
DEFAULT_LLM_PROTOCOL=chat_completions

# 会话有效期（天）
SESSION_TTL_DAYS=7

# 数据与产物目录
DATA_DIR=./data

# 微信登录（本期预留，未配置时接口返回「未启用」）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=

# ── 第三方口碑数据源（可选，默认全部关闭）────────────────────────────
# 仅在取得平台授权后启用。URL 指向合规网关，支持 {name} / {city} 占位符；
# 网关负责把各家 API 响应归一化成 { items: [{ rating, ratingScale, reviewCount, url, snippet }] }。
# 官方 API 数据一律实时取用、不落库（各平台条款禁止缓存评分与评论）；
# 只有开放数据集与用户录入/CSV 导入的数据会长期保存。
# 遇到 403 / 429 / 风控页面会自动熔断 5 分钟并降级为回源链接，不重试、不绕过。
# EVIDENCE_XHS_ENABLED=0
# EVIDENCE_XHS_URL=
# EVIDENCE_XHS_KEY=
# EVIDENCE_MFW_ENABLED=0
# EVIDENCE_MFW_URL=
# EVIDENCE_MFW_KEY=
# EVIDENCE_GOOGLE_ENABLED=0
# EVIDENCE_GOOGLE_URL=
# EVIDENCE_GOOGLE_KEY=
# EVIDENCE_TRIPADVISOR_ENABLED=0
# EVIDENCE_TRIPADVISOR_URL=
# EVIDENCE_TRIPADVISOR_KEY=
# EVIDENCE_AMAP_ENABLED=0
# EVIDENCE_AMAP_URL=
# EVIDENCE_AMAP_KEY=

# ── 小红书笔记检索（独立研究通道，默认关闭）────────────────────────
# 仅在部署者自行启动 tools/xhs-notes 的 sidecar 后才启用。主服务不含任何签名或反爬代码，
# 只调用本机 HTTP 接口；未启用时页面只提供小红书官方搜索入口，不发任何第三方请求。
# sidecar 仅监听 127.0.0.1，token 必须与 ~/.travel-planner-xhs.env 的 XHS_SIDECAR_TOKEN 一致。
# 检索结果只用于页面展示，不产生评分、不落库、不注入模型提示词、不写入导出 HTML。
# 上游开源项目自述「仅供学习交流、禁止商业化」且无 LICENSE，启用前请自行评估合规责任。
# XHS_NOTES_ENABLED=0
# XHS_NOTES_URL=http://127.0.0.1:8901
# XHS_NOTES_TOKEN=

# ── 地图定位（可选，默认零密钥即可用）──────────────────────────────
# 不配置任何 Key 时：为每个地点生成高德 URI API / Google Maps URLs 官方深链，
# 指南里的地图卡是系统绘制并明确标注「非实测地图」的示意图，绝不编造经纬度。
# 配置 Key 后：通过官方 API 取回真实坐标、地址与 POI ID，注入指南并约束模型不得编造位置信息。
# GEO_PROVIDER=auto     # auto（优先高德，国内可直连）| amap | google | none
# GEO_AMAP_KEY=         # 高德开放平台「Web服务API」类型 Key（需开通搜索 POI 服务）
# GEO_GOOGLE_KEY=       # Google Places API (New) / Static Maps Key，境内实例需合规跨境通道
# GEO_STATIC_MAP=0      # 1 = 导出 HTML 时实时抓取官方静态地图并内嵌；默认 0，只用自绘示意图
#                       # 图片不落库、不写进日志，HTML 里也不含任何 Key

# 合规出网通道（可选）：仅当部署方已有企业合规跨境通道或自有节点时填写。
# 填写后 start.sh 会自动打开 NODE_USE_ENV_PROXY，让 Node 内置 fetch 走该代理。
# HTTPS_PROXY=
