# 小红书笔记检索 sidecar 配置模板。
# 复制到 ~/.travel-planner-xhs.env 并 chmod 600；此文件绝不放在项目目录、绝不提交 Git。
# 生成 token：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# Spider_XHS 源码目录（由 ./bootstrap.sh 克隆，默认在用户主目录缓存下）
XHS_SPIDER_DIR="$HOME/.cache/spider-xhs"

# 你本人小红书账号浏览器登录后的完整 Cookie（至少包含 web_session / a1 / webId）。
# 只用于本机检索，不会写日志、不会回显、不会随 deploy.sh 发布；失效后需重新获取。
XHS_COOKIE=

# 主服务与 sidecar 之间的共享密钥，必须与主服务 .env 的 XHS_NOTES_TOKEN 完全一致。
XHS_SIDECAR_TOKEN=

# 仅监听 127.0.0.1，不对公网开放
XHS_SIDECAR_PORT=8901

# 两次检索之间的最小间隔（秒）与单次最大条数。请勿调低：高频抓取是账号与合规风险的主要来源。
XHS_SIDECAR_MIN_INTERVAL=3
XHS_SIDECAR_MAX_LIMIT=20
